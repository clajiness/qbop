<section>
  <div class="logo terminal-prompt"><a href="/" class="no-style">qbop</a></div>

  <form action="/account/change-password" method="post" role="form" id="change-password-form">
    <fieldset>
      <legend>change password</legend>
      <%= rodauth.change_password_additional_form_tags %>
      <%= rodauth.csrf_tag %>
      <div class="form-group">
        <label for="password">current password</label>
        <%= rodauth.input_field_string(rodauth.password_param, 'password', type: 'password', autocomplete: 'current-password') %>
      </div>
      <div class="form-group">
        <label for="new-password"><%= rodauth.new_password_label %></label>
        <%= rodauth.input_field_string(rodauth.new_password_param, 'new-password', type: 'password', autocomplete: 'new-password') %>
      </div>
      <%= rodauth.render('password-confirm-field') %>
      <div class="form-group">
        <%= rodauth.button(rodauth.change_password_button, class: 'btn btn-default') %>
      </div>
    </fieldset>
  </form>

  <p><a href="/account">back to account</a></p>
</section>
