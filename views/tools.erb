<%= erb :_nav, locals: { active: 'tools' }, layout: false %>
<% if @update_available %>
<div class="terminal-alert terminal-alert-primary"><a href="https://github.com/clajiness/qbop/releases" target="_blank">an update is available:</a> <a href="https://github.com/clajiness/qbop/releases/tag/<%= @recent_tag %>" target="_blank"><%= @recent_tag %></a></div>
<% end %>
<hr>

<div class="terminal-card">
  <header>import protonvpn wireguard config</header>
  <div>
    upload or paste a protonvpn wireguard configuration to update an existing opnsense instance and peer. qbop updates credentials, tunnel addresses within the adopted tunnel's existing address-family policy, peer endpoint/allowed ips, and optionally the peer name. opnsense-local settings such as dns, gateway, routing behavior, firewall rules, nat, interface assignments, and peer associations are preserved. qbop verifies the instance is absent from wireguard runtime state after disabling it, then verifies the imported instance and peer keys after re-enabling it. the configuration is not logged, saved, or returned in the response.
  </div>
</div>
<br>

<form action="/wireguard-import" method="post" enctype="multipart/form-data" id="wgimportform">
  <fieldset>
    <legend>import protonvpn wireguard config</legend>
    <% if request.env['rodauth'] %>
    <%= request.env.fetch('rodauth').csrf_tag('/wireguard-import') %>
    <% end %>
    <div class="form-group">
      <label for="wireguardinstance">opnsense instance</label>
      <select id="wireguardinstance" name="wireguardinstance" required>
        <option value="">select instance</option>
        <% @wireguard_targets.fetch(:instances, []).each do |instance| %>
        <option value="<%= Rack::Utils.escape_html(instance[:uuid]) %>" <%= 'selected' if @wireguard_instance_uuid == instance[:uuid] %>><%= Rack::Utils.escape_html([instance[:name], instance[:interface]].compact.join(' - ')) %></option>
        <% end %>
      </select>
    </div>
    <div class="form-group">
      <label for="wireguardpeer">opnsense peer</label>
      <select id="wireguardpeer" name="wireguardpeer" required>
        <option value="">select peer</option>
        <% @wireguard_targets.fetch(:peers, []).each do |peer| %>
        <option value="<%= Rack::Utils.escape_html(peer[:uuid]) %>" <%= 'selected' if @wireguard_peer_uuid == peer[:uuid] %>><%= Rack::Utils.escape_html(peer[:name]) %></option>
        <% end %>
      </select>
    </div>
    <div class="form-group">
      <label for="wireguardfile">configuration file</label>
      <input id="wireguardfile" name="wireguardfile" type="file" accept=".conf,text/plain"/>
    </div>
    <div class="form-group">
      <label for="wireguardconfig">or paste configuration</label>
      <textarea id="wireguardconfig" name="wireguardconfig" rows="12" placeholder="[Interface] ..." autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
    </div>
    <div class="form-group">
      <input id="wireguardrenamepeer" name="wireguardrenamepeer" type="checkbox" value="true"/>
      <label for="wireguardrenamepeer">Rename peer to match Proton server</label>
      <div>Uses Proton's server identifier to generate a name such as Proton_US-IL661.</div>
    </div>
    <div class="form-group">
      <input id="wireguardresult" name="wireguardresult" type="text" value="<%= Rack::Utils.escape_html(@wireguard_result) %>" placeholder="import result" readonly/>
    </div>
    <div class="form-group">
      <button class="btn btn-default btn-ghost" type="submit" name="wgimportsubmit" id="wgimportsubmit">import</button>
    </div>
  </fieldset>
</form>

<% if @wireguard_targets_error %>
<br>
<div class="terminal-alert terminal-alert-error" role="alert"><%= Rack::Utils.escape_html(@wireguard_targets_error) %></div>
<% end %>

<% if @wireguard_error %>
<br>
<div class="terminal-alert terminal-alert-error" role="alert"><%= Rack::Utils.escape_html(@wireguard_error) %></div>
<% end %>
<hr>

<div class="terminal-card">
  <header>generate wireguard public key</header>
  <div>
    enter a protonvpn wireguard private key to generate the corresponding public key. this tool is not logged, and key generation is local to this container.
  </div>
</div>
<br>

<form action="/pubkey" method="post" id="wgform">
  <fieldset>
    <legend>generate wireguard public key</legend>
    <div class="form-group">
      <input id="privatekey" name="privatekey" type="text" placeholder="private key"/>
    </div>
    <div class="form-group">
      <input id="publickey" name="publickey" type="text" value="<%= @public_key %>" readonly/>
    </div>
    <div class="form-group">
      <button class="btn btn-default btn-ghost" type="submit" name="keysubmit" id="keysubmit">generate</button>
    </div>
  </fieldset>
</form>
<hr>

<div class="terminal-card">
  <header>get public ip address</header>
  <div>
    get your current public ip address as seen by qbop. select your preferred whoami service. this tool is not logged.
  </div>
</div>
<br>

<form action="/public-ip" method="post" id="ipform">
  <fieldset>
    <legend>get public ip address</legend>
    <div class="form-group">
      <label for="select">select whoami service:</label>
      <select id="select" name="select">
        <option>akamai</option>
        <option>cloudflare</option>
        <option>google</option>
        <option>opendns</option>
      </select>
    </div>
    <div class="form-group">
      <input id="ipaddress" name="ipaddress" type="text" value="<%= @public_ip %>" readonly/>
    </div>
    <div class="form-group">
      <button class="btn btn-default btn-ghost" type="submit" name="ipsubmit" id="ipsubmit">retrieve</button>
    </div>
  </fieldset>
</form>
<br>
