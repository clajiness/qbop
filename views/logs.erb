<%= erb :_nav, locals: { active: 'logs' }, layout: false %>
<%= erb :_update_banner, layout: false %>
<hr>

<form action="/logs" method="get">
  <fieldset>
    <legend>log controls</legend>
    <div class="form-group">
      <label for="lines">lines</label>
      <input id="lines" name="lines" type="number" inputmode="numeric" pattern="[0-9]*" min="1" max="5000" value="<%= @log_lines %>">
    </div>

    <div class="form-group">
      <label for="direction">direction</label>
      <select id="direction" name="direction">
        <option value="asc" <%= 'selected' if @log_direction == 'asc' %>>oldest first</option>
        <option value="desc" <%= 'selected' if @log_direction == 'desc' %>>newest first</option>
      </select>
    </div>

    <div class="form-group">
      <button class="btn btn-default btn-ghost" type="submit">apply</button>
    </div>
  </fieldset>
</form>
<hr>

<%# Debounce until 500ms after the last log event; keep reconnect refreshes independent. %>
<div hidden hx-get="/partials/logs?lines=<%= @log_lines %>&amp;direction=<%= @log_direction %>"
    hx-trigger="sse:logs_changed delay:500ms" hx-target="#logs" hx-swap="innerHTML" hx-sync="#logs:queue last"></div>
<div id="logs" hx-get="/partials/logs?lines=<%= @log_lines %>&amp;direction=<%= @log_direction %>"
    hx-trigger="sse:refresh" hx-swap="innerHTML" hx-sync="this:queue last">
  <%= erb :_logs, layout: false %>
</div>
