<div class="terminal-nav">
  <div class="terminal-logo">
    <div class="logo terminal-prompt"><a href="/" class="no-style">qbop</a></div>
  </div>
  <nav class="terminal-menu">
    <ul>
      <li><a class="menu-item" href="/">stats</a></li>
      <li><a class="menu-item" href="/api-docs">api</a></li>
      <li><a class="menu-item" href="/tools">tools</a></li>
      <li><a class="menu-item active" href="/logs">logs</a></li>
      <li><a class="menu-item" href="/about">about</a></li>
    </ul>
  </nav>
</div>
<% if @update_available %>
<div class="terminal-alert terminal-alert-primary"><a href="https://github.com/clajiness/qbop/releases" target="_blank">an update is available:</a> <a href="https://github.com/clajiness/qbop/releases/tag/<%= @recent_tag %>" target="_blank"><%= @recent_tag %></a></div>
<% end %>
<hr>

<a class="btn btn-default btn-ghost" href="<%= Rack::Utils.escape_html(request.fullpath) %>">refresh</a><br><br>

<form action="/logs" method="get" class="control-bar log-controls control-panel">
  <span class="control-field">
    <label for="lines">lines</label>
    <input id="lines" name="lines" type="number" inputmode="numeric" pattern="[0-9]*" min="1" max="5000" value="<%= @log_lines %>">
  </span>
  <span class="control-field">
    <label for="direction">direction</label>
    <select id="direction" name="direction">
      <option value="asc" <%= 'selected' if @log_direction == 'asc' %>>oldest first</option>
      <option value="desc" <%= 'selected' if @log_direction == 'desc' %>>newest first</option>
    </select>
  </span>
  <span class="control-field">
    <label for="refresh">auto-refresh</label>
    <input id="refresh" name="refresh" type="number" inputmode="numeric" pattern="[0-9]*" min="0" max="3600" value="<%= @refresh_seconds %>">
    <span>sec</span>
  </span>
  <span class="control-actions">
    <button class="btn btn-default btn-ghost" type="submit">apply</button>
    <a class="btn btn-default btn-ghost" href="/logs?lines=<%= @log_lines %>&direction=<%= @log_direction %>&refresh=0">off</a>
  </span>
</form>
<hr>

<h4><em>last <%= @log_lines %> lines of log output, <%= @log_direction == 'desc' ? 'newest first' : 'oldest first' %></em></h4>
<section>
  <pre>
<% @output.each do |line| %>
<%= line %>
<% end %>
  </pre>
</section>

<a class="btn btn-default btn-ghost" href="<%= Rack::Utils.escape_html(request.fullpath) %>">refresh</a><br><br>
