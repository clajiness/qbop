<section>
  <div class="logo terminal-prompt"><a href="/" class="no-style">qbop</a></div>

  <form action="/account/change-email" method="post" role="form" id="change-login-form">
    <fieldset>
      <legend>change email</legend>
      <p>current email: <%= Rack::Utils.escape_html(rodauth.account!.fetch(:email)) %></p>
      <%= rodauth.change_login_additional_form_tags %>
      <%= rodauth.csrf_tag %>
      <div class="form-group">
        <label for="login">new email</label>
        <%= rodauth.input_field_string(rodauth.login_param, 'login', type: 'email', autocomplete: 'email') %>
      </div>
      <div class="form-group">
        <label for="password">current password</label>
        <%= rodauth.input_field_string(rodauth.password_param, 'password', type: 'password', autocomplete: 'current-password') %>
      </div>
      <div class="form-group">
        <%= rodauth.button(rodauth.change_login_button, class: 'btn btn-default') %>
      </div>
    </fieldset>
  </form>

  <p><a href="/account">back to account</a></p>
</section>
