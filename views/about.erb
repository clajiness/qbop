<%= erb :_nav, locals: { active: 'about' }, layout: false %>
<%= erb :_update_banner, layout: false %>
<hr>

<h4><em>app version</em></h4>
<blockquote>
  <%= @app_version %><br>
  <% if @main_build %>
    tracking main
  <% elsif !@release_build %>
    development build
  <% elsif @update_available %>
    <a href="https://github.com/clajiness/qbop/releases" target="_blank">an update is available:</a> <a href="https://github.com/clajiness/qbop/releases/tag/<%= @recent_tag %>" target="_blank"><%= @recent_tag %></a>
  <% else %>
    up to date
  <% end %>
</blockquote>

<h4><em>image</em></h4>
<blockquote>
  commit:
  <% if @app_commit == 'unknown' %>
    <%= @short_app_commit %>
  <% else %>
    <a href="<%= @repo_url %>/commit/<%= @app_commit %>" target="_blank"><%= @short_app_commit %></a>
  <% end %>
  <br>
  built: <%= @build_date %>
</blockquote>

<h4><em>schema version</em></h4>
<blockquote>
  <%= @schema_version %>
</blockquote>

<h4><em>ruby version</em></h4>
<blockquote>
  <%= @ruby_version %>
</blockquote>

<h4><em>app uptime</em></h4>
<blockquote>
  <%= @uptime %>
</blockquote>

<h4><em>github repo</em></h4>
<blockquote>
  <a href="<%= @repo_url %>" target="_blank"><%= @repo_url %></a>
</blockquote>
<hr>

<h4><em>account</em></h4>
<blockquote>
  <% if @web_auth_enabled %>
  <a href="/account">manage email and password</a>
  <br>
  <% end %>
  <a href="/api-keys">create and manage api keys</a>
</blockquote>
<hr>

<h4><em>configuration</em></h4>
<blockquote>
  UI_MODE: <%= Rack::Utils.escape_html(@ui_mode) %><br>
  LOOP_FREQ: <%= Rack::Utils.escape_html(@loop_freq) %><br>
  REQUIRED_ATTEMPTS: <%= Rack::Utils.escape_html(@required_attempts) %><br>
  LOG_LINES: <%= Rack::Utils.escape_html(@log_lines) %><br>
  LOG_REVERSE: <%= Rack::Utils.escape_html(@log_reverse) %><br>
  LOG_TO_STDOUT: <%= Rack::Utils.escape_html(@log_to_stdout) %><br>
  PORT_SOURCE: <%= Rack::Utils.escape_html(@port_source_name) %><br>
  GLUETUN_ADDR: <%= Rack::Utils.escape_html(@gluetun_addr) %><br>
  GLUETUN_API_KEY: ***<br>
  GLUETUN_USER: ***<br>
  GLUETUN_PASS: ***<br>
  GLUETUN_SSL_VERIFY: <%= Rack::Utils.escape_html(@gluetun_ssl_verify) %><br>
  PROTON_GATEWAY: <%= Rack::Utils.escape_html(@proton_gateway) %><br>
  OPN_SKIP: <%= Rack::Utils.escape_html(@opn_skip) %><br>
  OPN_INTERFACE_ADDR: <%= Rack::Utils.escape_html(@opn_interface_addr) %><br>
  OPN_API_KEY: <%= Rack::Utils.escape_html(@opn_api_key) %><br>
  OPN_API_SECRET: <%= Rack::Utils.escape_html(@opn_api_secret) %><br>
  OPN_ALIAS_NAME: <%= Rack::Utils.escape_html(@opn_alias_name) %><br>
  OPN_PROTON_ALIAS_NAME: <%= Rack::Utils.escape_html(@opn_proton_alias_name) %><br>
  OPN_SSL_VERIFY: <%= Rack::Utils.escape_html(@opn_ssl_verify) %><br>
  QBIT_SKIP: <%= Rack::Utils.escape_html(@qbit_skip) %><br>
  QBIT_ADDR: <%= Rack::Utils.escape_html(@qbit_addr) %><br>
  QBIT_API_KEY: <%= Rack::Utils.escape_html(@qbit_api_key) %><br>
  QBIT_USER: <%= Rack::Utils.escape_html(@qbit_user) %><br>
  QBIT_PASS: <%= Rack::Utils.escape_html(@qbit_pass) %><br>
  QBIT_SSL_VERIFY: <%= Rack::Utils.escape_html(@qbit_ssl_verify) %><br>
  WEB_AUTH_ENABLED: <%= Rack::Utils.escape_html(@web_auth_enabled) %><br>
  OIDC_ENABLED: <%= Rack::Utils.escape_html(@oidc_enabled) %><br>
  OIDC_ISSUER: <%= Rack::Utils.escape_html(@oidc_issuer) %><br>
  OIDC_CLIENT_ID: <%= Rack::Utils.escape_html(@oidc_client_id) %><br>
  OIDC_CLIENT_SECRET: <%= Rack::Utils.escape_html(@oidc_client_secret) %><br>
  OIDC_PUBLIC_URL: <%= Rack::Utils.escape_html(@oidc_public_url) %><br>
  OIDC_AUTO_REDIRECT: <%= Rack::Utils.escape_html(@oidc_auto_redirect) %><br>
  LOCAL_LOGIN_ENABLED: <%= Rack::Utils.escape_html(@local_login_enabled) %>
</blockquote>
<hr>

<h4><em>ruby gems</em></h4>
<section>
  <pre>
<% @gemfile.each do |line| %>
<%= line %>
<% end %>
  </pre>
</section>
