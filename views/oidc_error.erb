<section>
  <div class="logo terminal-prompt"><a href="/" class="no-style">qbop</a></div>
  <fieldset>
    <legend>OpenID Connect sign-in failed</legend>
    <div class="terminal-alert terminal-alert-error" role="alert"><%= Rack::Utils.escape_html(@oidc_error) %></div>
    <br>
    <form action="<%= Framework::Authentication::OIDC_REQUEST_PATH %>" method="post">
      <%= request.env.fetch('rodauth').csrf_tag(Framework::Authentication::OIDC_REQUEST_PATH) %>
      <button class="btn btn-default" type="submit">try OpenID Connect again</button>
    </form>
    <br>
    <% if @auth_config.local_login_enabled? %>
    <p><a href="/login">sign in with email and password</a></p>
    <% end %>
  </fieldset>
</section>
